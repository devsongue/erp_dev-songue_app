DATABASE_URL="postgresql://user:password@localhost:5432/erp"
# Taille max du pool de connexions Postgres (defaut : 10)
DATABASE_POOL_MAX="10"
GEOAPIFY_API_KEY=""
# Inscription publique en self-service : "true" pour ouvrir /register apres
# l'installation initiale, sinon la page redirige vers /login.
ALLOW_PUBLIC_REGISTRATION="false"
